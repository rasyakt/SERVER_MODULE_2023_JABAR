	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Should return login success message\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Login success\");",
									"});",
									"",
									"pm.test(\"Should return user detail and accessToken\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.user).to.have.property(\"accessToken\");",
									"    pm.expect(jsonData.user.email).to.eql(\"user1@webtech.id\");",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.user.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user1@webtech.id\",\n    \"password\": \"password1\"\n}"
						},
						"url": {
							"raw": "{{DOMAIN}}/api/v1/auth/login",
							"host": [
								"{{DOMAIN}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Log in with valid user credentials to obtain a bearer token from Laravel Sanctum."
					},
					"response": []
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Should return logout success message\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Logout success\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{DOMAIN}}/api/v1/auth/logout",
							"host": [
								"{{DOMAIN}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Log out from the system and invalidate the Sanctum token."
					},
					"response": []
